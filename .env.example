# Copy to .env and fill in. .env is gitignored.

# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram chat id. The bot ONLY responds to this id.
# Leave blank temporarily, message the bot, then run: python3 bot.py
# and the console prints the chat id of whoever messages -> paste it here.
ALLOWED_CHAT_ID=

# Where Claude runs from. Default: this folder (dedicated sandbox).
# Change to /Users/austingriffith/clawd to let it roam your projects.
WORKDIR=

# Optional overrides (usually leave blank)
CLAUDE_BIN=
PERMISSION_FLAG=--dangerously-skip-permissions
